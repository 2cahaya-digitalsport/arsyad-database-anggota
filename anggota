        async function prosesLoginAnggota(event) {
            event.preventDefault();
            const userInput = document.getElementById("login-user").value.trim();
            const passInput = document.getElementById("login-pass").value;
            const errorBox = document.getElementById("login-error");
            const errorText = document.getElementById("login-error-text");
            const btn = document.getElementById("btn-login");

            errorBox.classList.add("hidden");

            if (!userInput || !passInput) {
                errorText.innerText = "Mohon isi User dan Password Anda.";
                errorBox.classList.remove("hidden");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Memeriksa Akun...</span>`;

            try {
                const [snapAnggota, snapPersetujuan, snapBaru] = await Promise.all([
                    database.ref("administrasi_digital/anggota").once("value"),
                    database.ref("administrasi_digital/persetujuan_admin").once("value"),
                    database.ref("administrasi_digital/anggota_baru").once("value")
                ]);

                const rawAnggota = snapAnggota.val();
                const listAnggota = rawAnggota ? Object.entries(rawAnggota).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                const userLower = userInput.toLowerCase();

                const ditemukanAktif = listAnggota.find(item => {
                    const userDb = String(item.username || item.user || "").trim().toLowerCase();
                    const passDb = String(item.password || item.sandi || "");
                    const st = String(item.status || "Dikonfirmasi").toLowerCase();
                    return userDb !== "" && userDb === userLower && passDb !== "" && passDb === passInput && st !== "menunggu" && st !== "ditolak";
                });

                if (ditemukanAktif) {
                    anggotaAktif = ditemukanAktif;
                    dataAnggota = listAnggota.filter(a => {
                        const st = String(a.status || "Dikonfirmasi").toLowerCase();
                        return st !== "menunggu" && st !== "ditolak";
                    });
                    sessionStorage.setItem("anggota_id_login", String(ditemukanAktif.id));
                    bukaPortalAnggota();
                    return;
                }

                const rawPersetujuan = snapPersetujuan.val();
                const listPersetujuan = rawPersetujuan ? Object.values(rawPersetujuan) : [];
                const rawBaru = snapBaru.val();
                const listBaru = rawBaru ? Object.values(rawBaru) : [];

                const gabungAntrean = [...listPersetujuan, ...listBaru, ...listAnggota];
                const ditemukanAntrean = gabungAntrean.find(item => {
                    const userDb = String(item.username || item.user || "").trim().toLowerCase();
                    const passDb = String(item.password || item.sandi || "");
                    return userDb !== "" && userDb === userLower && passDb !== "" && passDb === passInput;
                });

                if (ditemukanAntrean) {
                    const st = String(ditemukanAntrean.status || "Menunggu").toLowerCase();
                    if (st === "ditolak") {
                        errorText.innerText = "Pendaftaran Anda ditolak oleh Admin. Silakan hubungi pengurus.";
                    } else {
                        errorText.innerText = "Akun Anda sudah terdaftar dan masih menunggu persetujuan Admin.";
                    }
                    errorBox.classList.remove("hidden");
                    return;
                }

                errorText.innerText = "User atau password tidak sesuai dengan data anggota terdaftar.";
                errorBox.classList.remove("hidden");
            } catch (err) {
                errorText.innerText = "Gagal terhubung ke server: " + err.message;
                errorBox.classList.remove("hidden");
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-right-to-bracket"></i> <span>MASUK PORTAL ANGGOTA</span>`;
            }
        }

