        // ==================== ARSIP & SINKRONISASI RIWAYAT NILAI PERMANEN PER TANGGAL ====================
        function getStorageKeyRiwayatNilai() {
            return anggotaAktif ? `pn_riwayat_nilai_v2_${anggotaAktif.id}` : "";
        }

        function normalisasiRiwayatObjek(raw) {
            const hasil = {
                berat_badan: (raw && raw.berat_badan) || "",
                cleared_at: (raw && raw.cleared_at) || "",
                cleared_sig: (raw && raw.cleared_sig) || "",
                per_tanggal: {}
            };
            if (!raw || typeof raw !== "object") return hasil;

            if (raw.per_tanggal && typeof raw.per_tanggal === "object") {
                Object.entries(raw.per_tanggal).forEach(([tgl, entri]) => {
                    if (!entri || typeof entri !== "object") return;
                    hasil.per_tanggal[tgl] = {
                        tanggal: entri.tanggal || tgl,
                        berat_badan: entri.berat_badan !== undefined ? entri.berat_badan : hasil.berat_badan,
                        updated_at: entri.updated_at || "",
                        kategori: entri.kategori && typeof entri.kategori === "object"
                            ? JSON.parse(JSON.stringify(entri.kategori))
                            : {}
                    };
                });
            }

            // Migrasi format arsip lama (v1 tanpa per_tanggal) agar tidak hilang
            if (raw.kategori && typeof raw.kategori === "object" && Object.keys(raw.kategori).length > 0) {
                Object.entries(raw.kategori).forEach(([katId, katObj]) => {
                    if (!katObj || typeof katObj !== "object") return;
                    const tglTebak = (katObj.updated_at && /^\d{4}-\d{2}-\d{2}/.test(katObj.updated_at))
                        ? katObj.updated_at.slice(0, 10)
                        : getTodayDateStr();
                    if (!hasil.per_tanggal[tglTebak]) {
                        hasil.per_tanggal[tglTebak] = {
                            tanggal: tglTebak,
                            berat_badan: hasil.berat_badan,
                            updated_at: katObj.updated_at || "",
                            kategori: {}
                        };
                    }
                    if (!hasil.per_tanggal[tglTebak].kategori[katId]) {
                        hasil.per_tanggal[tglTebak].kategori[katId] = JSON.parse(JSON.stringify(katObj));
                    }
                });
            }
            return hasil;
        }

        function muatRiwayatNilaiLokal() {
            const key = getStorageKeyRiwayatNilai();
            if (!key) return;
            try {
                const raw = localStorage.getItem(key);
                if (raw) {
                    riwayatNilaiLokal = normalisasiRiwayatObjek(JSON.parse(raw));
                } else {
                    // Cek juga key versi v1 bila pernah tersimpan
                    const oldKey = anggotaAktif ? `pn_riwayat_nilai_v1_${anggotaAktif.id}` : "";
                    const oldRaw = oldKey ? localStorage.getItem(oldKey) : null;
                    if (oldRaw) {
                        riwayatNilaiLokal = normalisasiRiwayatObjek(JSON.parse(oldRaw));
                        simpanRiwayatNilaiKeLokal();
                    }
                }
            } catch (e) {
                riwayatNilaiLokal = { berat_badan: "", cleared_at: "", cleared_sig: "", per_tanggal: {} };
            }
        }

        function simpanRiwayatNilaiKeLokal() {
            const key = getStorageKeyRiwayatNilai();
            if (!key) return;
            try {
                localStorage.setItem(key, JSON.stringify(riwayatNilaiLokal));
            } catch (e) {}
        }

        function gabungArsipRiwayatDariDb() {
            if (!riwayatNilaiDb || typeof riwayatNilaiDb !== "object") return;
            const dbNorm = normalisasiRiwayatObjek(riwayatNilaiDb);
            const dbClearedAt = dbNorm.cleared_at || "";
            const lokalClearedAt = riwayatNilaiLokal.cleared_at || "";

            if (dbClearedAt && (!lokalClearedAt || dbClearedAt > lokalClearedAt)) {
                riwayatNilaiLokal = dbNorm;
                simpanRiwayatNilaiKeLokal();
                return;
            }

            if (dbNorm.berat_badan !== undefined && dbNorm.berat_badan !== "") {
                riwayatNilaiLokal.berat_badan = dbNorm.berat_badan;
            }

            Object.entries(dbNorm.per_tanggal || {}).forEach(([tglKey, tglObj]) => {
                if (!riwayatNilaiLokal.per_tanggal[tglKey]) {
                    riwayatNilaiLokal.per_tanggal[tglKey] = JSON.parse(JSON.stringify(tglObj));
                } else {
                    const targetTgl = riwayatNilaiLokal.per_tanggal[tglKey];
                    if (tglObj.berat_badan !== undefined && tglObj.berat_badan !== "") {
                        targetTgl.berat_badan = tglObj.berat_badan;
                    }
                    if ((tglObj.updated_at || "") > (targetTgl.updated_at || "")) {
                        targetTgl.updated_at = tglObj.updated_at;
                    }
                    targetTgl.kategori = targetTgl.kategori || {};
                    Object.entries(tglObj.kategori || {}).forEach(([katId, katObj]) => {
                        if (!katObj || typeof katObj !== "object") return;
                        if (!targetTgl.kategori[katId]) {
                            targetTgl.kategori[katId] = JSON.parse(JSON.stringify(katObj));
                        } else {
                            const targetKat = targetTgl.kategori[katId];
                            targetKat.nama = katObj.nama || targetKat.nama;
                            targetKat.catatan = katObj.catatan !== undefined ? katObj.catatan : targetKat.catatan;
                            targetKat.updated_at = katObj.updated_at || targetKat.updated_at;
                            targetKat.aspek = targetKat.aspek || {};
                            Object.entries(katObj.aspek || {}).forEach(([aspId, aspObj]) => {
                                if (!aspObj) return;
                                targetKat.aspek[aspId] = { ...(targetKat.aspek[aspId] || {}), ...aspObj };
                            });
                        }
                    });
                }
            });
            simpanRiwayatNilaiKeLokal();
        }

        function namaKategoriRaport(katKey, tanggal = "") {
            if (tanggal && raportSubmenusPerTanggal[tanggal]) {
                const fTgl = raportSubmenusPerTanggal[tanggal].find(s => String(s.id) === String(katKey));
                if (fTgl && fTgl.nama) return fTgl.nama;
            }
            const found = raportSubmenus.find(s => String(s.id) === String(katKey));
            if (found && found.nama) return found.nama;
            const str = String(katKey || "");
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        function namaAspekRaport(katKey, aspKey, fallbackNama = "") {
            const list = raportKriteria[katKey] || [];
            const found = list.find(c => String(c.id) === String(aspKey));
            if (found && found.nama) return found.nama;
            return fallbackNama || `Aspek ${aspKey}`;
        }

        // Gabungkan nilai baru dari raport_nilai (termasuk per_tanggal) ke arsip permanen per tanggal tanpa menghapus tanggal lama
        function sinkronRiwayatNilai() {
            if (!anggotaAktif) return;

            const bbAktif = (anggotaAktif.berat_badan !== undefined && anggotaAktif.berat_badan !== null && String(anggotaAktif.berat_badan).trim() !== "")
                ? anggotaAktif.berat_badan
                : (raportNilaiAnggota && raportNilaiAnggota.berat_badan ? raportNilaiAnggota.berat_badan : riwayatNilaiLokal.berat_badan);

            let adaPerubahan = false;
            if (bbAktif !== undefined && bbAktif !== "" && bbAktif !== riwayatNilaiLokal.berat_badan) {
                riwayatNilaiLokal.berat_badan = bbAktif;
                adaPerubahan = true;
            }

            if (!riwayatNilaiLokal.per_tanggal) riwayatNilaiLokal.per_tanggal = {};

            if (raportNilaiAnggota && typeof raportNilaiAnggota === "object") {
                const currentSig = JSON.stringify(raportNilaiAnggota);
                const clearedAt = riwayatNilaiLokal.cleared_at || "";
                const clearedSig = riwayatNilaiLokal.cleared_sig || "";

                const serapSatuKategoriKeTanggal = (tglKey, katKey, katVal) => {
                    if (!katVal || typeof katVal !== "object" || !katVal.skor) return;

                    if (clearedAt) {
                        const itemUpdated = katVal.updated_at || "";
                        if (itemUpdated) {
                            if (itemUpdated <= clearedAt) return;
                        } else if (clearedSig === currentSig) {
                            return;
                        }
                    }

                    const skorEntries = Object.entries(katVal.skor).filter(([, v]) =>
                        v !== undefined && v !== null && v !== "" && !isNaN(Number(v))
                    );
                    if (skorEntries.length === 0) return;

                    if (!riwayatNilaiLokal.per_tanggal[tglKey]) {
                        riwayatNilaiLokal.per_tanggal[tglKey] = {
                            tanggal: tglKey,
                            berat_badan: bbAktif || "",
                            updated_at: katVal.updated_at || "",
                            kategori: {}
                        };
                        adaPerubahan = true;
                    }

                    const targetTgl = riwayatNilaiLokal.per_tanggal[tglKey];
                    if (bbAktif !== undefined && bbAktif !== "" && targetTgl.berat_badan !== bbAktif) {
                        targetTgl.berat_badan = bbAktif;
                        adaPerubahan = true;
                    }
                    if (katVal.updated_at && katVal.updated_at > (targetTgl.updated_at || "")) {
                        targetTgl.updated_at = katVal.updated_at;
                        adaPerubahan = true;
                    }

                    const katNama = namaKategoriRaport(katKey, tglKey);
                    if (!targetTgl.kategori[katKey]) {
                        targetTgl.kategori[katKey] = {
                            id: katKey,
                            nama: katNama,
                            catatan: katVal.catatan || "",
                            updated_at: katVal.updated_at || "",
                            aspek: {}
                        };
                        adaPerubahan = true;
                    }

                    const targetKat = targetTgl.kategori[katKey];
                    if (targetKat.nama !== katNama) {
                        targetKat.nama = katNama;
                        adaPerubahan = true;
                    }
                    if ((katVal.catatan || "") !== (targetKat.catatan || "")) {
                        targetKat.catatan = katVal.catatan || "";
                        adaPerubahan = true;
                    }
                    if ((katVal.updated_at || "") !== (targetKat.updated_at || "")) {
                        targetKat.updated_at = katVal.updated_at || "";
                        adaPerubahan = true;
                    }
                    if (!targetKat.aspek) targetKat.aspek = {};

                    skorEntries.forEach(([aspId, nilaiSkor]) => {
                        const existingAsp = targetKat.aspek[aspId];
                        const aspNama = namaAspekRaport(katKey, aspId, existingAsp ? existingAsp.nama : "");
                        const numVal = Number(nilaiSkor);

                        if (!existingAsp || existingAsp.nama !== aspNama || Number(existingAsp.nilai) !== numVal) {
                            targetKat.aspek[aspId] = {
                                id: aspId,
                                nama: aspNama,
                                nilai: numVal
                            };
                            adaPerubahan = true;
                        }
                    });
                };

                // 1. Format per_tanggal dari menu Penilaian Raport
                if (raportNilaiAnggota.per_tanggal && typeof raportNilaiAnggota.per_tanggal === "object") {
                    Object.entries(raportNilaiAnggota.per_tanggal).forEach(([tglKey, tglObj]) => {
                        if (!tglObj || typeof tglObj !== "object") return;
                        Object.entries(tglObj).forEach(([katKey, katVal]) => {
                            serapSatuKategoriKeTanggal(tglKey, katKey, katVal);
                        });
                    });
                }

                // 2. Fallback format lama (flat tanpa per_tanggal)
                Object.entries(raportNilaiAnggota).forEach(([katKey, katVal]) => {
                    if (katKey === "berat_badan" || katKey === "per_tanggal") return;
                    if (!katVal || typeof katVal !== "object" || !katVal.skor) return;
                    const tglFallback = katVal.tanggal
                        || ((katVal.updated_at && /^\d{4}-\d{2}-\d{2}/.test(katVal.updated_at)) ? katVal.updated_at.slice(0, 10) : getTodayDateStr());
                    serapSatuKategoriKeTanggal(tglFallback, katKey, katVal);
                });
            }

            simpanRiwayatNilaiKeLokal();

            const dbStr = JSON.stringify(riwayatNilaiDb || {});
            const lokalStr = JSON.stringify(riwayatNilaiLokal);
            if (adaPerubahan && dbStr !== lokalStr) {
                database.ref("administrasi_digital/riwayat_nilai_anggota/" + anggotaAktif.id).set(riwayatNilaiLokal).catch(() => {});
            }

            renderRiwayatNilai();
        }

        function getSemuaKolomKategoriRiwayat() {
            const map = new Map();
            (raportSubmenus || DEFAULT_SUBMENUS).forEach(s => {
                if (s && s.id) map.set(s.id, s.nama || namaKategoriRaport(s.id));
            });
            Object.values(raportSubmenusPerTanggal || {}).forEach(arr => {
                (arr || []).forEach(s => {
                    if (s && s.id && !map.has(s.id)) map.set(s.id, s.nama || namaKategoriRaport(s.id));
                });
            });
            Object.entries(riwayatNilaiLokal.per_tanggal || {}).forEach(([tglKey, tglObj]) => {
                Object.entries((tglObj && tglObj.kategori) || {}).forEach(([katId, katObj]) => {
                    if (!map.has(katId)) {
                        map.set(katId, (katObj && katObj.nama) || namaKategoriRaport(katId, tglKey));
                    }
                });
            });
            return Array.from(map.entries()).map(([id, nama]) => ({ id, nama }));
        }

        function hitungRekapSatuTanggal(tglKey, daftarKolom) {
            const tglObj = (riwayatNilaiLokal.per_tanggal && riwayatNilaiLokal.per_tanggal[tglKey]) || { tanggal: tglKey, kategori: {} };
            const katMap = tglObj.kategori || {};
            const perKategori = {};
            const listKategoriDetail = [];
            const rataTerisi = [];

            daftarKolom.forEach(kol => {
                const arsipKat = katMap[kol.id];
                const aspekList = arsipKat
                    ? Object.values(arsipKat.aspek || {}).filter(a => a && a.nilai !== undefined && a.nilai !== null && !isNaN(Number(a.nilai)))
                    : [];
                const rata = aspekList.length > 0
                    ? Math.round((aspekList.reduce((s, a) => s + Number(a.nilai), 0) / aspekList.length) * 10) / 10
                    : null;
                perKategori[kol.id] = rata;
                if (rata !== null) rataTerisi.push(rata);
                if (arsipKat && aspekList.length > 0) {
                    listKategoriDetail.push({
                        id: kol.id,
                        nama: arsipKat.nama || kol.nama,
                        catatan: arsipKat.catatan || "",
                        aspekList,
                        rata
                    });
                }
            });

            // Sertakan jika ada kategori ekstra di katMap yang belum masuk daftarKolom
            Object.entries(katMap).forEach(([katId, arsipKat]) => {
                if (daftarKolom.some(k => k.id === katId)) return;
                const aspekList = Object.values((arsipKat && arsipKat.aspek) || {}).filter(a => a && a.nilai !== undefined && a.nilai !== null && !isNaN(Number(a.nilai)));
                const rata = aspekList.length > 0
                    ? Math.round((aspekList.reduce((s, a) => s + Number(a.nilai), 0) / aspekList.length) * 10) / 10
                    : null;
                perKategori[katId] = rata;
                if (rata !== null) rataTerisi.push(rata);
                if (aspekList.length > 0) {
                    listKategoriDetail.push({
                        id: katId,
                        nama: arsipKat.nama || namaKategoriRaport(katId, tglKey),
                        catatan: arsipKat.catatan || "",
                        aspekList,
                        rata
                    });
                }
            });

            const nilaiAkhir = rataTerisi.length > 0
                ? Math.round((rataTerisi.reduce((s, v) => s + v, 0) / rataTerisi.length) * 10) / 10
                : null;

            return {
                tanggal: tglKey,
                berat_badan: tglObj.berat_badan || riwayatNilaiLokal.berat_badan || "",
                perKategori,
                listKategoriDetail,
                nilaiAkhir
            };
        }

        function getDaftarRiwayatPerTanggal() {
            const daftarKolom = getSemuaKolomKategoriRiwayat();
            const entries = Object.keys(riwayatNilaiLokal.per_tanggal || {})
                .sort((a, b) => a.localeCompare(b)) // Urut kronologis sehingga tanggal baru selalu masuk di nomor berikutnya
                .map(tglKey => hitungRekapSatuTanggal(tglKey, daftarKolom))
                .filter(item => item.nilaiAkhir !== null || item.listKategoriDetail.length > 0);

            return { daftarKolom, entries };
        }

        function renderPaginationRiwayatNilai(page, totalPages, startIdx, endIdx, total) {
            const container = document.getElementById("pagination-riwayat-nilai");
            if (!container) return;

            if (total === 0) {
                container.classList.add("hidden");
                container.innerHTML = "";
                return;
            }

            const pages = [];
            if (totalPages <= 5) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
            } else {
                pages.push(1);
                if (page > 3) pages.push("...");
                const start = Math.max(2, page - 1);
                const end = Math.min(totalPages - 1, page + 1);
                for (let i = start; i <= end; i++) pages.push(i);
                if (page < totalPages - 2) pages.push("...");
                pages.push(totalPages);
            }

            const pageButtons = pages.map(p => {
                if (p === "...") {
                    return `<span class="px-2 py-1 text-slate-400 select-none">...</span>`;
                }
                const active = p === page;
                return `
                    <button type="button" onclick="gantiHalamanRiwayatNilai(${p})"
                        class="min-w-[30px] h-[30px] px-2 rounded-lg text-xs font-bold transition-colors cursor-pointer ${
                            active
                                ? "bg-emerald-600 text-white shadow-sm"
                                : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-100"
                        }">
                        ${p}
                    </button>
                `;
            }).join("");

            container.className = "px-4 py-3 border-t border-slate-200 bg-slate-50 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs";
            container.innerHTML = `
                <p class="text-[11px] text-slate-500 font-medium">
                    Menampilkan <b class="text-slate-700">${startIdx + 1}–${endIdx}</b> dari <b class="text-slate-700">${total}</b> riwayat tanggal
                    <span class="text-slate-400">• Halaman ${page} / ${totalPages}</span>
                </p>
                <div class="flex items-center gap-1 flex-wrap justify-center">
                    <button type="button" onclick="gantiHalamanRiwayatNilai(${page - 1})" ${page <= 1 ? "disabled" : ""}
                        class="h-[30px] px-2.5 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i>
                    </button>
                    ${pageButtons}
                    <button type="button" onclick="gantiHalamanRiwayatNilai(${page + 1})" ${page >= totalPages ? "disabled" : ""}
                        class="h-[30px] px-2.5 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </button>
                </div>
            `;
        }

        function gantiHalamanRiwayatNilai(page) {
            riwayatNilaiPage = page;
            renderRiwayatNilai();
        }

