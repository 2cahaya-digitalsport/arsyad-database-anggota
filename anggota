        // Render Dashboard Khusus Ranting / Rayon Anggota Pribadi
        function renderDashboard() {
            if (!anggotaAktif) return;

            const rayonAnggota = (anggotaAktif.ranting_rayon || "").trim();
            const namaAnggota = anggotaAktif.nama_lengkap || "-";
            const niaAnggota = (anggotaAktif.nia && anggotaAktif.nia.trim() !== "") ? anggotaAktif.nia : "Belum Memiliki NIA";

            const detailRayon = dataRayon.find(r => cocokNamaRayon(r.nama_rayon_ranting, rayonAnggota));

            document.getElementById("dash-nama-rayon").innerText = (detailRayon && detailRayon.nama_rayon_ranting)
                ? detailRayon.nama_rayon_ranting
                : (rayonAnggota || "Ranting / Rayon Belum Diatur");
            document.getElementById("dash-kategori-badge").innerText = (detailRayon && detailRayon.kategori_rr)
                ? detailRayon.kategori_rr
                : "Rayon / Ranting";
            document.getElementById("dash-salam-anggota").innerText = `${namaAnggota} • NIA: ${niaAnggota}`;

            document.getElementById("dash-jadwal-hari").innerText = (detailRayon && detailRayon.jadwal_hari) ? detailRayon.jadwal_hari : "-";
            document.getElementById("dash-jam-latihan").innerText = (detailRayon && detailRayon.jam_latihan) ? detailRayon.jam_latihan : "-";
            document.getElementById("dash-lokasi-latihan").innerText = (detailRayon && detailRayon.lokasi_latihan) ? detailRayon.lokasi_latihan : "-";

            const anggotaRayon = rayonAnggota
                ? dataAnggota.filter(a => cocokNamaRayon(a.ranting_rayon, rayonAnggota))
                : [anggotaAktif];

            const totalAnggota = anggotaRayon.length;
            let totalPutra = 0;
            let totalPutri = 0;

            const mapKualifikasi = {};
            anggotaRayon.forEach(a => {
                const gender = klasifikasiGender(a.jenis_kelamin);
                if (gender === "putra") totalPutra++;
                else if (gender === "putri") totalPutri++;

                const kval = (a.kualifikasi_usia || "").trim() || "Belum Diisi";
                mapKualifikasi[kval] = (mapKualifikasi[kval] || 0) + 1;
            });

            const persenPutra = totalAnggota > 0 ? Math.round((totalPutra / totalAnggota) * 100) : 0;
            const persenPutri = totalAnggota > 0 ? Math.round((totalPutri / totalAnggota) * 100) : 0;

            document.getElementById("dash-total-anggota").innerText = totalAnggota;
            document.getElementById("dash-total-putra").innerText = totalPutra;
            document.getElementById("dash-persen-putra").innerText = `${persenPutra}% dari total`;
            document.getElementById("dash-total-putri").innerText = totalPutri;
            document.getElementById("dash-persen-putri").innerText = `${persenPutri}% dari total`;

            const daftarPelatih = [];
            const seenPelatih = new Set();

            function tambahPelatih(namaRaw) {
                const nama = String(namaRaw || "").trim();
                if (!nama) return;
                const lower = nama.toLowerCase();
                if (["-", "belum ditunjuk", "tidak ada", "kosong", "none"].includes(lower)) return;
                if (!seenPelatih.has(lower)) {
                    seenPelatih.add(lower);
                    daftarPelatih.push(nama);
                }
            }

            if (dataPelatih.length > 0 && rayonAnggota) {
                dataPelatih.forEach(p => {
                    const rayonPelatih = p.ranting_rayon || p.rayon_ranting || p.nama_rayon_ranting || p.rayon || p.ranting || p.tempat_latihan || "";
                    if (cocokNamaRayon(rayonPelatih, rayonAnggota)) {
                        tambahPelatih(p.nama_lengkap || p.nama_pelatih || p.nama);
                    }
                });
            }

            if (detailRayon) {
                const rawPelatih = detailRayon.pelatih_tetap || detailRayon.pelatih || "";
                if (Array.isArray(rawPelatih)) {
                    rawPelatih.forEach(tambahPelatih);
                } else if (typeof rawPelatih === "string" && rawPelatih.trim() !== "") {
                    rawPelatih
                        .split(/[,;/\n&]|\s+dan\s+/i)
                        .forEach(tambahPelatih);
                }
            }

            anggotaRayon.forEach(a => {
                const peran = `${a.jabatan || ""} ${a.status || ""} ${a.peran || ""} ${a.kualifikasi_usia || ""}`.toLowerCase();
                if (peran.includes("pelatih")) {
                    tambahPelatih(a.nama_lengkap);
                }
            });

            document.getElementById("dash-total-pelatih").innerText = daftarPelatih.length;

            const listPelatihEl = document.getElementById("dash-list-pelatih");
            if (daftarPelatih.length === 0) {
                listPelatihEl.innerHTML = `
                    <div class="text-center py-6 px-3 rounded-xl bg-slate-50 border border-dashed border-slate-200 text-xs text-slate-400">
                        Belum ada pelatih yang tercatat untuk ranting/rayon ini.
                    </div>
                `;
            } else {
                listPelatihEl.innerHTML = daftarPelatih.map((nama, idx) => `
                    <div class="flex items-center gap-3 p-3 rounded-xl bg-purple-50/60 border border-purple-100">
                        <div class="w-8 h-8 rounded-full bg-purple-600 text-white text-xs font-bold flex items-center justify-center shrink-0">
                            ${idx + 1}
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs sm:text-sm font-bold text-slate-800 truncate">${esc(nama)}</p>
                            <p class="text-[10px] text-purple-600 font-semibold">Pelatih ${esc(document.getElementById("dash-nama-rayon").innerText)}</p>
                        </div>
                    </div>
                `).join("");
            }

            const urutanKualifikasi = ["usia dini 1", "usia dini 2", "usia dini", "pra remaja", "remaja", "dewasa", "pelatih", "warga"];
            const entriKualifikasi = Object.entries(mapKualifikasi).sort((a, b) => {
                const aLow = a[0].toLowerCase();
                const bLow = b[0].toLowerCase();
                if (aLow === "belum diisi") return 1;
                if (bLow === "belum diisi") return -1;
                const idxA = urutanKualifikasi.indexOf(aLow);
                const idxB = urutanKualifikasi.indexOf(bLow);
                if (idxA !== -1 && idxB !== -1) return idxA - idxB;
                if (idxA !== -1) return -1;
                if (idxB !== -1) return 1;
                return aLow.localeCompare(bLow);
            });

            const jumlahKategoriValid = entriKualifikasi.filter(([k]) => k.toLowerCase() !== "belum diisi").length;
            document.getElementById("dash-jumlah-kualifikasi").innerText = `${jumlahKategoriValid} Kualifikasi`;

            const listKualifikasiEl = document.getElementById("dash-list-kualifikasi");
            if (entriKualifikasi.length === 0) {
                listKualifikasiEl.innerHTML = `
                    <div class="col-span-full text-center py-6 text-xs text-slate-400">
                        Belum ada data kualifikasi anggota pada ranting/rayon ini.
                    </div>
                `;
            } else {
                listKualifikasiEl.innerHTML = entriKualifikasi.map(([namaKual, jumlah]) => {
                    const persen = totalAnggota > 0 ? Math.round((jumlah / totalAnggota) * 100) : 0;
                    return `
                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-xs font-bold text-slate-700">${esc(namaKual)}</span>
                                <span class="text-xs font-black text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full">
                                    ${jumlah} Anggota
                                </span>
                            </div>
                            <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full transition-all" style="width: ${persen}%"></div>
                            </div>
                            <p class="text-[10px] text-slate-400 text-right">${persen}% dari total anggota</p>
                        </div>
                    `;
                }).join("");
            }
        }

