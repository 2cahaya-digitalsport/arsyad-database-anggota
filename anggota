        // Cetak PDF pada Baris / Tanggal Tertentu
        function cetakPDFRiwayatNilaiPerTanggal(tglKey) {
            if (!anggotaAktif) return;
            const { daftarKolom, entries } = getDaftarRiwayatPerTanggal();
            const idx = entries.findIndex(e => e.tanggal === tglKey);
            if (idx === -1) {
                alert("Data nilai pada tanggal tersebut tidak ditemukan.");
                return;
            }
            document.getElementById("print-area").innerHTML = buatHtmlRaportSatuTanggal(entries[idx], daftarKolom, idx + 1);
            setTimeout(() => window.print(), 150);
        }

        // Cetak PDF Seluruh Riwayat Tanggal
        function cetakPDFRiwayatNilai() {
            if (!anggotaAktif) return;
            const { daftarKolom, entries } = getDaftarRiwayatPerTanggal();
            if (entries.length === 0) {
                alert("Belum ada nilai raport untuk dicetak.");
                return;
            }
            document.getElementById("print-area").innerHTML = entries
                .map((entri, idx) => buatHtmlRaportSatuTanggal(entri, daftarKolom, idx + 1))
                .join("");
            setTimeout(() => window.print(), 200);
