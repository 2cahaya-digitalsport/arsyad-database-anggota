        }

        // Navigasi Menu Sidebar
        function pilihTab(tab) {
            tabAktif = tab;

            const judulMap = {
                dashboard: "Dashboard Anggota",
                biodata: "Biodata Pribadi Anggota",
                absensi: "Absensi Pribadi Anggota",
                riwayat: "Riwayat Pembayaran Pribadi",
                "riwayat-nilai": "Riwayat Nilai & Raport",
                agenda: "Data Agenda Kegiatan",
                jadwal: "Jadwal Latihan Rayon & Ranting",
                kas: "Laporan Kas Organisasi",
                surat: "Administrasi Surat"
            };
            document.getElementById("topbar-title").innerText = judulMap[tab] || "Portal Anggota";

            document.querySelectorAll(".sidebar-btn").forEach(btn => {
                if (btn.dataset.tab === tab) {
                    btn.classList.add("sidebar-link-active");
                    btn.classList.remove("text-slate-300", "hover:bg-slate-800");
                } else {
                    btn.classList.remove("sidebar-link-active");
                    btn.classList.add("text-slate-300", "hover:bg-slate-800");
                }
            });

            document.querySelectorAll(".portal-section").forEach(el => el.classList.add("hidden"));

            if (tab === "dashboard") {
                document.getElementById("sec-dashboard").classList.remove("hidden");
                renderDashboard();
            } else if (tab === "biodata") {
                document.getElementById("sec-biodata").classList.remove("hidden");
            } else if (tab === "absensi") {
                document.getElementById("sec-absensi").classList.remove("hidden");
                renderAbsensiPribadi();
            } else if (tab === "riwayat") {
                document.getElementById("sec-riwayat").classList.remove("hidden");
                renderRiwayatPembayaran();
            } else if (tab === "riwayat-nilai") {
                document.getElementById("sec-riwayat-nilai").classList.remove("hidden");
                renderRiwayatNilai();
            } else if (tab === "agenda") {
                document.getElementById("sec-agenda").classList.remove("hidden");
            } else if (tab === "jadwal") {
                document.getElementById("sec-jadwal").classList.remove("hidden");
            } else if (tab === "kas") {
                document.getElementById("sec-kas").classList.remove("hidden");
            } else if (tab === "surat") {
                document.getElementById("sec-surat").classList.remove("hidden");
            }

            updateBannerJadwalHariIni();

            if (window.innerWidth < 1024) {
                setSidebar(false);
            }
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // Cek sesi login otomatis saat halaman di-refresh & muat dropdown rayon pendaftaran
        window.addEventListener("DOMContentLoaded", async () => {
            muatDropdownRayonPendaftaran();

            const savedId = sessionStorage.getItem("anggota_id_login");
            if (savedId) {
                try {
                    const snap = await database.ref("administrasi_digital/anggota/" + savedId).once("value");
                    const val = snap.val();
                    const st = String(val?.status || "Dikonfirmasi").toLowerCase();
                    if (snap.exists() && st !== "menunggu" && st !== "ditolak") {
                        anggotaAktif = { ...val, id: val.id || savedId };
                        bukaPortalAnggota();
                    } else {
                        sessionStorage.removeItem("anggota_id_login");
                    }
                } catch (e) {
                    sessionStorage.removeItem("anggota_id_login");
                }
            }
        });
    </script>
</body>
</html>
