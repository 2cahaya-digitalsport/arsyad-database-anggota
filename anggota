        function getRiwayatPembayaranPribadi() {
            if (!anggotaAktif) return [];

            const namaAnggotaNorm = (anggotaAktif.nama_lengkap || "").trim().toLowerCase();
            const rayonAnggota = (anggotaAktif.ranting_rayon || "").trim();

            return dataKasAnggota.filter(item => {
                if (item.anggota_id !== undefined && item.anggota_id !== null && String(item.anggota_id) !== "") {
                    return String(item.anggota_id) === String(anggotaAktif.id);
                }
                const namaCocok = (item.nama_anggota || "").trim().toLowerCase() === namaAnggotaNorm;
                const rayonCocok = !item.ranting_rayon || !rayonAnggota || cocokNamaRayon(item.ranting_rayon, rayonAnggota);
                return namaCocok && rayonCocok;
            });
        }

        function getFilteredRiwayatPembayaran() {
            const bulanDipilih = document.getElementById("filter-riwayat-bulan")?.value || "";
            const statusDipilih = document.getElementById("filter-riwayat-status")?.value || "";

            return getRiwayatPembayaranPribadi().filter(item => {
                const st = item.status || "Dikonfirmasi";
                const matchBulan = !bulanDipilih || String(item.tanggal || "").startsWith(bulanDipilih);
                const matchStatus = !statusDipilih || st === statusDipilih;
                return matchBulan && matchStatus;
            });
        }

