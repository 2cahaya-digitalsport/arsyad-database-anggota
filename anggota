        // Hapus Semua Riwayat Nilai di Sisi Peserta
        async function hapusSemuaRiwayatNilai() {
            if (!anggotaAktif) return;
            const { entries } = getDaftarRiwayatPerTanggal();
            if (entries.length === 0) {
                alert("Tidak ada riwayat nilai yang tersimpan untuk dihapus.");
                return;
            }

            if (!confirm("Yakin ingin menghapus SEMUA riwayat nilai Anda? Data yang dihapus tidak dapat dikembalikan.")) return;

            const nowIso = new Date().toISOString();
            const sig = raportNilaiAnggota ? JSON.stringify(raportNilaiAnggota) : "";

            riwayatNilaiLokal = {
                berat_badan: riwayatNilaiLokal.berat_badan || "",
                cleared_at: nowIso,
                cleared_sig: sig,
                per_tanggal: {}
            };
            riwayatNilaiPage = 1;
            selectedDetailTanggal = "";
            simpanRiwayatNilaiKeLokal();

            try {
                await database.ref("administrasi_digital/riwayat_nilai_anggota/" + anggotaAktif.id).set(riwayatNilaiLokal);
            } catch (e) {}

            renderRiwayatNilai();
        }

        // Bangun HTML 1 Halaman Raport PDF untuk 1 Tanggal Tertentu
        function buatHtmlRaportSatuTanggal(entri, daftarKolom, nomorUrut = 1) {
            const pred = getPredikat(entri.nilaiAkhir);
            const umur = hitungUmurTahun(anggotaAktif.tanggal_lahir);
            const kategoriGender = formatKategoriGender(anggotaAktif);
            const bbVal = entri.berat_badan || anggotaAktif.berat_badan || riwayatNilaiLokal.berat_badan || "";
            const bbStr = formatBeratBadan(bbVal);
            const tanggalPenilaian = formatTanggal(entri.tanggal);

            const fotoRaw = anggotaAktif.foto || "";
            const fotoHtml = (fotoRaw && !fotoRaw.includes("via.placeholder.com") && !fotoRaw.includes("application/pdf"))
                ? `<img src="${esc(fotoRaw)}" alt="Foto" class="raport-foto">`
                : `<div class="raport-inisial">${esc(getInisial(anggotaAktif.nama_lengkap))}</div>`;

            const kolomDipakai = daftarKolom.filter(k =>
                entri.perKategori[k.id] !== undefined && entri.perKategori[k.id] !== null
